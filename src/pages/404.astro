---
import Base from "../layouts/Base.astro";
import { phone } from "../data/school";
---
<Base lang="uk" title="Сторінку не знайдено | Bauer" description="Такої сторінки немає. Поверніться на головну Bauer School Львів.">
  <section class="nf container">
    <h1>Такої сторінки немає</h1>
    <p class="muted">Можливо, адресу введено з помилкою.</p>
    <p class="nf__actions">
      <a class="btn btn--primary" href="/">На головну</a>
      <a class="link nums" href={phone.href}>{phone.display}</a>
    </p>
  </section>
</Base>

<style>
  .nf { min-height: 80svh; display: grid; align-content: center; gap: var(--space-3); padding-block: var(--space-6); }
  .nf__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; }
</style>
