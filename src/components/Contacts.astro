---
import { phone, email, address, socials } from "../data/school";
---
<section id="contacts" class="contacts section on-night" aria-labelledby="contacts-title" data-rec="U-R003">
  <div class="container">
    <h2 id="contacts-title">Запишіться на пробне</h2>

    <div class="call" data-reveal="grow">
      <svg class="call__loop" viewBox="0 0 600 220" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M 70 214 C 16 202 4 124 20 80 C 50 20 200 6 320 8 C 470 10 590 40 594 110 C 598 180 480 212 320 214 C 220 215 120 213 44 194" />
      </svg>
      <a class="call__number nums" href={phone.href} data-rec="U-R003">{phone.display}</a>
      <p class="call__who">{phone.admin}, адміністратор</p>
      <p class="muted">{phone.hours}</p>
    </div>

    <div class="info">
      <div class="info__col">
        <h3 class="info__h">E-mail</h3>
        <p><a class="link" href={email.trialHref}>{email.address}</a></p>
        <p class="muted">Відповідь протягом 24 годин</p>
      </div>
      <div class="info__col">
        <h3 class="info__h">Адреса</h3>
        <address class="info__addr">{address.place}<br />{address.street}, {address.locality}<br />{address.region}</address>
        <p><a class="link" href={address.mapHref} target="_blank" rel="noopener">Відкрити на карті</a></p>
      </div>
      <div class="info__col">
        <h3 class="info__h">Соцмережі</h3>
        <ul class="social" data-rec="S-R013,M-R004">
          {socials.map((s) => (
            <li>
              <a class="link" href={s.href} target="_blank" rel="noopener">{s.name}</a>
              {"note" in s && <span class="muted">({s.note})</span>}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .call { position: relative; margin-top: var(--space-5); padding: var(--space-4) var(--space-3); display: grid; gap: 4px; justify-items: start; width: fit-content; max-width: 100%; }
  .call__loop { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .call__loop path { fill: none; stroke: var(--color-accent); stroke-width: var(--trail-w); stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .call__number {
    position: relative; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-number); line-height: 1.05;
    text-decoration: none; white-space: nowrap; border-radius: 6px;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .call__number:hover { color: var(--color-accent); }
  .call__who { font-size: var(--fs-lead); margin-top: var(--space-1); }
  :global(.js) .call:not(.is-visible) .call__loop { clip-path: inset(0 100% 0 0); }
  .call__loop { transition: clip-path var(--dur-draw) var(--ease-out) 150ms; }

  .info { margin-top: var(--space-5); display: grid; gap: var(--space-4); }
  .info__col { display: grid; gap: var(--space-1); align-content: start; }
  .info__h { font-size: var(--fs-lead); }
  .info__addr { font-style: normal; }
  .info a.link { min-height: 32px; display: inline-flex; align-items: center; }
  .social { display: grid; gap: 2px; }
  .social li { display: flex; flex-wrap: wrap; align-items: center; gap: 0 .4em; }

  @media (max-width: 420px) {
    .call { padding-inline: var(--space-2); }
  }
  @media (min-width: 900px) {
    .info { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); }
    .call { padding: var(--space-5) var(--space-6) var(--space-5) var(--space-5); }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .call:not(.is-visible) .call__loop { clip-path: none; }
  }
</style>
