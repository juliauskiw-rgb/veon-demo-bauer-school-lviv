---
import FutureLink from "./FutureLink.astro";
import { FUTURE } from "../data/school";

// Facts: client.json business_lines[0] (ages, levels), B-F008 (rental skates, group after the trial, moving up).
const MIN = 3, MAX = 18;
const groups = [
  { name: "START", from: 3, to: 7, level: "Початківці", text: "Перші кроки на льоду. Перші заняття можна в прокатних ковзанах.", photo: null },
  { name: "ADVANCED", from: 6, to: 12, level: "Аматори", text: "Змагання аматорів і льодові шоу.", photo: { base: "advanced", alt: "Юна фігуристка Bauer у червоній сукні на льоду" } },
  { name: "SPORT", from: 6, to: 18, level: "Професійний рівень", text: "Спортивна підготовка й змагання.", photo: { base: "sport", alt: "Спортсменка Bauer виконує елемент на льоду" } },
];
const ages = Array.from({ length: MAX - MIN + 1 }, (_, i) => MIN + i);
const pos = (a: number) => ((a - MIN) / (MAX - MIN)) * 100;
const B = import.meta.env.BASE_URL;
---
<section id="groups" class="groups section" aria-labelledby="groups-title" data-rec="U-R008,S-R015">
  <div class="container">
    <div class="groups__head">
      <h2 id="groups-title">Три групи — від перших кроків до змагань</h2>
      <p class="groups__lead muted">Знайдіть вік дитини на шкалі. Межі груп перетинаються, тому остаточно групу радить тренер.</p>
    </div>

    <div class="scale" data-reveal="grow">
      <ol class="scale__ruler" aria-hidden="true">
        {ages.map((a) => <li style={`--x:${pos(a)}%`} class:list={["scale__tick", { "scale__tick--major": [3, 6, 7, 12, 18].includes(a) }]}><span data-n={a}></span></li>)}
      </ol>

      <ul class="scale__rows">
        <li class="scale__trail" aria-hidden="true">
          <svg viewBox="0 0 100 800" preserveAspectRatio="none" focusable="false"><path d="M 26.67 120 C 34 210 12 300 20 400 C 28 500 10 590 20 680" /></svg>
        </li>
        {groups.map((g, i) => (
          <li class:list={["row", `row--${g.name.toLowerCase()}`]} style={`--from:${pos(g.from)}%; --to:${pos(g.to)}%; --i:${i}`}>
            <div class="row__track" aria-hidden="true"><span class="row__bar"></span></div>
            <div class="row__body">
              <div class="row__text">
                <h3 class="row__name">{g.name}</h3>
                <p class="row__age nums">{g.from}–{g.to} років</p>
                <p class="row__level">{g.level}</p>
                <p class="row__desc muted">{g.text}</p>
                <FutureLink note={FUTURE} class="row__more">Детальніше про групу</FutureLink>
              </div>
              {!g.photo && (
                <div class="row__photo row__photo--note">
                  <p>Прокатні ковзани підійдуть</p>
                </div>
              )}
              {g.photo && (
                <div class="row__photo">
                  <img
                    src={`${B}images/${g.photo.base}-360.webp`}
                    srcset={`${B}images/${g.photo.base}-360.webp 360w, ${B}images/${g.photo.base}-720.webp 720w`}
                    sizes="(min-width: 900px) 220px, 34vw"
                    width="720" height="1078" loading={i === 1 ? "eager" : "lazy"} decoding="async"
                    alt={g.photo.alt} data-rec="P-R004"
                  />
                </div>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="groups__foot">
      <p class="groups__pick">Групу підбере тренер після пробного заняття. Перехід між групами — за рекомендацією тренера, зазвичай через <span class="nowrap">6–12 місяців</span>.</p>
      <a class="btn btn--ghost" href="#trial">Як проходить пробне</a>
    </div>
  </div>
</section>

<style>
  .groups { padding-top: var(--space-5); }
  .groups__head { display: grid; gap: var(--space-2); max-width: 44rem; }
  .groups__lead { font-size: var(--fs-lead); }

  .scale { position: relative; margin-top: var(--space-5); }
  .scale__ruler { display: none; }

  /* Phone: each group carries its own vertical 3–18 track on the left; the bar marks its ages. */
  .scale__rows { display: grid; gap: var(--space-4); }
  .row { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: var(--space-2); }
  .row__track { position: relative; width: 4px; justify-self: center; background: var(--color-ice-line); border-radius: 4px; min-height: 100%; }
  .row__bar {
    position: absolute; left: -2px; right: -2px; top: var(--from); height: calc(var(--to) - var(--from));
    background: var(--color-text); border-radius: 6px;
    transform-origin: center top;
    transition: transform 700ms var(--ease-out);
  }
  .row--start .row__bar { background: var(--color-accent); }
  .row__body { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-2); align-items: start; }
  .row__text { display: grid; gap: 4px; justify-items: start; }
  .row__name { font-size: var(--fs-h3); }
  .row__age { font-family: var(--font-display); font-size: clamp(2rem, 1.5rem + 2vw, 3rem); line-height: 1; font-weight: 600; margin-block: 4px; }
  .row__level { font-weight: 600; }
  .row__desc { max-width: 30ch; }
  .row__more { margin-top: var(--space-1); font-size: var(--fs-caption); min-height: 32px; }
  .row__photo { width: clamp(96px, 30vw, 160px); aspect-ratio: 3 / 4; border-radius: 50%; overflow: hidden; background: var(--color-ice-line); }
  .row__photo img { width: 100%; height: 100%; object-fit: cover; }
  .row__photo--note { display: grid; place-items: center; padding: var(--space-2); text-align: center; border: var(--trail-w) solid var(--color-accent); background: var(--color-surface); }
  .row__photo--note p { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-body); line-height: 1.25; }
  .scale__trail { display: none; }

  @media (max-width: 479px) {
    .row__body { grid-template-columns: minmax(0, 1fr); }
    .row__photo { width: 128px; }
  }
  :global(.js) .scale:not(.is-visible) .row__bar { transform: scaleY(0); }

  .groups__foot { margin-top: var(--space-5); display: grid; gap: var(--space-3); justify-items: start; max-width: 40rem; }
  .groups__pick { font-size: var(--fs-lead); }

  /* Desktop: one horizontal ruler 3…18, bars of real length, text under the start of each bar. */
  @media (min-width: 900px) {
    .scale__ruler {
      display: block; position: relative; height: 40px; margin-bottom: var(--space-3);
      border-bottom: 1px solid var(--color-border);
    }
    .scale__tick { position: absolute; left: var(--x); bottom: 0; transform: translateX(-50%); display: grid; justify-items: center; gap: var(--space-1); }
    .scale__tick::after { content: ""; width: 1px; height: 8px; background: var(--color-border); }
    .scale__tick span { font-size: var(--fs-caption); color: var(--color-text-muted); }
    .scale__tick span::before { content: attr(data-n); }
    .scale__tick--major span { color: var(--color-text); font-weight: 600; }
    .scale__tick--major::after { height: 14px; width: 2px; background: var(--color-accent); }

    .scale { --text-col: 19rem; --photo-col: 180px; --gap: var(--space-4); }
    .scale__ruler { margin-left: calc(var(--text-col) + var(--gap)); margin-right: calc(var(--photo-col) + var(--gap)); }
    .scale__rows { position: relative; gap: var(--space-4); }
    .row {
      grid-template-columns: minmax(0, var(--text-col)) minmax(0, 1fr) var(--photo-col);
      grid-template-areas: "text track photo"; align-items: center; gap: var(--gap);
      height: 240px;
    }
    .row__body { display: contents; }
    .row__text { grid-area: text; }
    .row__photo { grid-area: photo; width: var(--photo-col); justify-self: end; }
    .row__track { grid-area: track; width: 100%; height: 6px; min-height: 0; justify-self: stretch; position: relative; z-index: 1; }
    .row__bar {
      left: var(--from); right: auto; top: -2px; bottom: -2px; height: auto; width: calc(var(--to) - var(--from));
      transform-origin: left center; transition-delay: calc(var(--i) * 120ms);
    }
    :global(.js) .scale:not(.is-visible) .row__bar { transform: scaleX(0); }
    .row__age { font-size: clamp(2rem, 1.2rem + 1.6vw, 2.75rem); }
    /* Golden trail joins the bars: from the end of START down to where ADVANCED and SPORT begin. */
    .scale__trail {
      display: block; position: absolute; top: 0; bottom: 0; pointer-events: none;
      left: calc(var(--text-col) + var(--gap)); right: calc(var(--photo-col) + var(--gap));
    }
    .scale__trail svg { width: 100%; height: 100%; overflow: visible; }
    .scale__trail path { fill: none; stroke: var(--color-accent); stroke-width: 2px; stroke-linecap: round; vector-effect: non-scaling-stroke; }
    .scale__trail svg { transition: clip-path var(--dur-draw) var(--ease-out) 400ms; }
    :global(.js) .scale:not(.is-visible) .scale__trail svg { clip-path: inset(0 0 100% 0); }
    .groups__foot { grid-template-columns: minmax(0, 1fr) auto; align-items: center; max-width: none; gap: var(--space-4); }
    .groups__pick { max-width: 40rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .scale:not(.is-visible) .row__bar { transform: none; }
    :global(.js) .scale:not(.is-visible) .scale__trail svg { clip-path: none; }
  }
</style>
