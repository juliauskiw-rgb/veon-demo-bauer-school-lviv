---
import Icon from "./Icon.astro";
import { phone } from "../data/school";
const B = import.meta.env.BASE_URL;
---
<section id="hero" class="hero" aria-labelledby="hero-title" data-rec="U-R002,U-R006,G-R002">
  <div class="container">
    <h1 id="hero-title" class="hero__title" data-rec="SEO-R006,U-R008">
      <span class="hero__line">Школа фігурного катання</span>
      <span class="hero__line">для дітей 3–18 років у Львові</span>
    </h1>

    <div class="figure">
      <!-- Signature: the golden skate trail draws a figure eight around the first step and the call. -->
      <svg class="trail trail--wide" viewBox="0 0 1240 470" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M 2 0 C 4 30 100 34 300 34 C 450 34 540 140 620 236 C 700 334 800 440 950 440 C 1130 440 1238 350 1238 236 C 1238 124 1130 30 950 30 C 800 30 700 138 620 236 C 540 334 450 446 290 446 C 120 446 2 352 2 236 C 2 140 70 76 200 58" />
      </svg>

      <div class="figure__offer">
        <p class="hero__sentence">З&nbsp;3 років, на ковзанці King Cross у Сокільниках. Перше тренування — 2 години, безкоштовно.</p>
        <a class="btn btn--primary btn--block-sm hero__cta" href={phone.href} data-rec="U-R002,U-R003">
          <Icon name="phone" /><span>Записатися на <span class="hero__cta-word">безкоштовне </span>пробне</span>
        </a>
        <p class="hero__phone">
          <a class="link nums" href={phone.href}>{phone.display}</a>
          <span class="muted">адміністратор, {phone.hours}</span>
        </p>
      </div>
      <div class="figure__loop">
        <svg class="trail trail--tall" viewBox="0 0 390 560" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path d="M 195 64 C 236 40 246 4 195 4 C 144 4 154 40 195 64 C 320 120 356 200 356 316 C 356 452 284 554 195 554 C 106 554 34 452 34 316 C 34 200 70 120 195 64 Z" />
        </svg>
        <div class="figure__photo">
          <picture>
            <img
              src={`${B}images/start-720.webp`}
              srcset={`${B}images/start-480.webp 480w, ${B}images/start-720.webp 720w, ${B}images/start-853.webp 853w`}
              sizes="(min-width: 900px) 272px, 64vw"
              width="853" height="1280"
              alt="Тренер Bauer тримає за руки дівчинку, яка робить перші кроки на льоду"
              fetchpriority="high" decoding="async"
              data-rec="P-R001,P-R004,G-R008"
            />
          </picture>
          <!-- Client's own training video (from the current home page). The photo stays the LCP and the fallback;
               the source is attached only after window load, never with reduced motion or Save-Data. -->
          <video class="figure__video" data-hero-video data-src={`${B}videos/bauer-training.mp4`} poster={`${B}images/start-720.webp`}
            muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
          <button class="video-toggle" type="button" data-video-toggle hidden aria-pressed="false">
            <svg class="video-toggle__icon video-toggle__icon--pause" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5v14M16 5v14" /></svg>
            <svg class="video-toggle__icon video-toggle__icon--play" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5.5v13l10.5-6.5Z" /></svg>
            <span class="visually-hidden" data-video-label>Пауза відео</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Attach the client's video only after the page has loaded, so the photo stays the LCP element.
  const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-video-toggle]");
  const label = document.querySelector<HTMLElement>("[data-video-label]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
  function start() {
    if (!video || !toggle || reduce || saveData) return;
    video.src = video.dataset.src || "";
    video.addEventListener("playing", () => { video.classList.add("is-playing"); toggle.hidden = false; }, { once: true });
    video.play().catch(() => { /* autoplay refused: the photo stays */ });
    toggle.addEventListener("click", () => {
      const paused = !video.paused;
      if (paused) video.pause(); else video.play().catch(() => {});
      toggle.setAttribute("aria-pressed", String(paused));
      if (label) label.textContent = paused ? "Відтворити відео" : "Пауза відео";
    });
  }
  if (document.readyState === "complete") start(); else window.addEventListener("load", start, { once: true });
</script>

<style>
  .hero { padding-top: clamp(1.5rem, 0.8rem + 2.4vw, 3rem); padding-bottom: var(--space-2); }
  .hero__title { font-weight: 600; max-width: 14ch; }
  .hero__line { display: inline; }

  .figure { position: relative; margin-top: var(--space-3); padding-top: var(--space-1); }
  .trail { position: absolute; pointer-events: none; overflow: visible; }
  .trail path { fill: none; stroke: var(--color-accent); stroke-width: var(--trail-w); stroke-linecap: round; vector-effect: non-scaling-stroke; }

  /* Phone and tablet: offer first, then a vertical «8» with the oval photo peeking at the fold. */
  .figure__offer { display: grid; gap: var(--space-2); justify-items: start; max-width: 34rem; }
  .hero__sentence { font-size: var(--fs-lead); line-height: 1.45; }
  .hero__cta { white-space: nowrap; }
  @media (max-width: 419px) { .hero__cta-word { display: none; } }
  .hero__phone { display: grid; gap: 2px; font-size: var(--fs-caption); }
  .hero__phone .link { font-weight: 600; font-size: var(--fs-body); }

  .trail--wide { display: none; }
  .figure__loop {
    --ph: min(64vw, 300px);
    --loop-h: calc((var(--ph) * 4 / 3 + 72px) * 1.13);
    position: relative; height: var(--loop-h); margin-top: var(--space-2);
  }
  .trail--tall { inset: 0; width: 100%; height: 100%; }
  .figure__photo {
    position: absolute; left: 50%; top: calc(var(--loop-h) * 0.1143 + 36px);
    width: var(--ph); aspect-ratio: 3 / 4; transform: translateX(-50%);
    border-radius: 50%; overflow: hidden;
    background: var(--color-ice-line);
  }
  .figure__photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }

  /* Client video inside the oval: fades in over the photo once it actually plays. */
  .figure__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; opacity: 0; transition: opacity 600ms var(--ease-out); }
  .figure__video.is-playing { opacity: 1; }
  .video-toggle {
    position: absolute; left: 50%; bottom: 9%; transform: translateX(-50%);
    width: 44px; height: 44px; border-radius: 50%; border: 0; display: grid; place-items: center;
    background: color-mix(in srgb, var(--color-night) 72%, transparent); color: var(--color-surface); cursor: pointer;
    transition: background-color 200ms var(--ease-out), transform 200ms var(--ease-out);
  }
  .video-toggle[hidden] { display: none; }
  .video-toggle:hover { background: var(--color-night); }
  .video-toggle:active { transform: translateX(-50%) scale(0.94); }
  .video-toggle:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 3px; }
  .video-toggle__icon { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .video-toggle__icon--play { fill: currentColor; stroke: none; display: none; }
  .video-toggle[aria-pressed="true"] .video-toggle__icon--pause { display: none; }
  .video-toggle[aria-pressed="true"] .video-toggle__icon--play { display: block; }
  @media (prefers-reduced-motion: reduce) { .figure__video { transition: none; } }

  @media (min-width: 600px) {
    .hero__title { max-width: none; }
  }

  /* Desktop: H1 across, the horizontal ∞ below — photo in the left loop, the offer in the right loop. */
  @media (min-width: 900px) {
    .hero { padding-bottom: var(--space-3); }
    .hero__line { display: block; }
    .figure {
      display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center;
      height: clamp(380px, 30vw, 440px); margin-top: var(--space-2); padding-top: 0;
    }
    .figure__loop { display: contents; }
    .trail--tall { display: none; }
    .trail--wide { display: block; inset: 0; width: 100%; height: 100%; }
    .figure__photo {
      position: relative; left: auto; top: auto; grid-row: 1; grid-column: 1; justify-self: center;
      width: clamp(200px, 19vw, 272px); transform: translateX(-2%);
    }
    .figure__offer {
      grid-row: 1; grid-column: 2; justify-self: center;
      width: min(100%, 25rem); transform: translateX(6%);
      gap: var(--space-3);
    }
    .hero__sentence { font-size: var(--fs-lead); }
  }

  /* Motion 1: the trail draws itself after first paint (clip-path only). Text and button never wait. */
  :global(.draw) .trail--wide { animation: trail-x var(--dur-draw) var(--ease-out) 150ms both; }
  :global(.draw) .trail--tall { animation: trail-y 600ms var(--ease-out) 150ms both; }
  @keyframes trail-x { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes trail-y { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }
  @media (prefers-reduced-motion: reduce) {
    :global(.draw) .trail--wide, :global(.draw) .trail--tall { animation: none; clip-path: none; }
  }
</style>
