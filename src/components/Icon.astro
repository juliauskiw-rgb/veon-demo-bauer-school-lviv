---
// Functional line icons only (1.5 px stroke, currentColor), decorative: aria-hidden.
interface Props { name: "phone" | "menu" | "close" | "mail" | "pin"; size?: number; class?: string; }
const { name, size = 20, class: cls } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "phone" && <path d="M5.5 3.5h3l1.5 4-2 1.3a11 11 0 0 0 6.2 6.2l1.3-2 4 1.5v3a2 2 0 0 1-2 2A16.5 16.5 0 0 1 3.5 5.5a2 2 0 0 1 2-2Z" />}
  {name === "menu" && <><path d="M4 8h16" /><path d="M4 16h16" /></>}
  {name === "close" && <><path d="M6 6l12 12" /><path d="M18 6L6 18" /></>}
  {name === "mail" && <><rect x="3.5" y="5.5" width="17" height="13" rx="2" /><path d="m4 7 8 6 8-6" /></>}
  {name === "pin" && <><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.3" /></>}
</svg>
